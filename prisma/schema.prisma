// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Room {
  id       Int        @id @default(autoincrement())
  // Set once by /start with a conditional update, so only one request creates tiles.
  started  Boolean    @default(false)
  // Lets the cleanup job skip rooms that were just created and are still empty.
  createdAt DateTime  @default(now())
  boards   Board[]
  messages Message[]
}

model Board {
  id       Int      @id @default(autoincrement())
  roomId   Int
  playerId String
  playerName String @default("")
  // 0 or 1. Unique per room, so a third concurrent join fails in the database.
  slot     Int
  tiles    Tile[]
  room Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  chosenRow Int?
  chosenCol Int?
  disconnectedAt DateTime?

  @@unique([roomId, slot])
  @@unique([roomId, playerId])
  @@index([disconnectedAt])
}
model Message {
  id       Int      @id @default(autoincrement())
  roomId   Int
  playerId String
  playerName String @default("")
  room Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message String
}

model Tile {
  id       Int      @id @default(autoincrement())
  row      Int
  col      Int
  name     String
  photoUrl String
  flipped  Boolean
  boardId  Int
  board    Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([row, col, boardId])
}