# Required: at least 32 bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Optional: seconds a disconnected player keeps their seat (default 30)
GRACE_SECONDS=30

# Optional: port to listen on (default 3000; Render/AWS set it for you)
PORT=
# Optional: interface to bind. Defaults to 127.0.0.1 in dev and 0.0.0.0 in production.
# Set to 0.0.0.0 to test from other devices on your LAN.
HOST=

# Optional, dev/LAN only: serve HTTPS directly from Node. Absolute paths to files
# OUTSIDE the repo, e.g. from
#   mkcert -key-file ~/.config/guess_who/key.pem -cert-file ~/.config/guess_who/cert.pem localhost 127.0.0.1 <LAN IP>
# In production, TLS is terminated by the platform (Render / AWS load balancer).
TLS_KEY=
TLS_CERT=
